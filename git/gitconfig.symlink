# Local/private config goes in the include
[alias]
        co = checkout
        count   = !git shortlog -sn
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor = vim
        pager = delta
        autocrlf = input
        # Windows-only knobs, ignored elsewhere
        symlinks = true
        longpaths = true
        fscache = true
[apply]
        whitespace = nowarn
[diff]
        # colour relocated blocks apart from real additions and deletions
        colorMoved = default
[merge]
        # conflict markers include the common ancestor
        conflictstyle = zdiff3
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[delta]
        navigate = true
        line-numbers = true
[init]
        defaultBranch = main
[help]
        autocorrect = 30
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
        default = simple
        autoSetupRemote = true
[pull]
        ff = only
[credential]
	gitHubAccountFiltering = false
	azreposCredentialType = oauth
	msauthUseBroker = true
	msauthUseDefaultAccount = true
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[include]
        path = ~/.gitconfig.local
[user]
        useConfigOnly = true
