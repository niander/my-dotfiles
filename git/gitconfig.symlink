# Local/private config goes in the include
[alias]
        co = checkout
        count   = !git shortlog -sn
        change-commits = "!f() { VAR1=$1; VAR='$'$1; OLD=$2; NEW=$3; echo \"Are you sure for replace $VAR $OLD => $NEW ?(Y/N)\";read OK;if [ \"$OK\" = 'Y' ] ; then shift 3; git filter-branch --env-filter \"if [ \\\"${VAR}\\\" = '$OLD' ]; then export $VAR1='$NEW';echo 'to $NEW'; fi\" $@; fi;}; f "
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor = vim
        pager = delta
        autocrlf = input
        # Windows-only knobs, ignored elsewhere
        symlinks = true
        longpaths = true
        fscache = true
[apply]
        whitespace = nowarn
[diff]
        # colour relocated blocks apart from real additions and deletions
        colorMoved = default
[merge]
        # conflict markers include the common ancestor
        conflictstyle = zdiff3
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[delta]
        navigate = true
        line-numbers = true
[init]
        defaultBranch = main
[help]
        autocorrect = 30
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
        default = simple
        autoSetupRemote = true
[pull]
        ff = only
[credential]
	gitHubAccountFiltering = false
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[user]
        name = niander
        email = 4544122+niander@users.noreply.github.com
[include]
        path = ~/.gitconfig.local
[user]
        useConfigOnly = true
