#!/usr/bin/env bash
#
# bootstrap installs things.
# CHANGES:
#   - relative path folder script stolen from @scarfacedeb
#    

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

# MSYS deep-copies on `ln -s`, leaving snapshots that stop following the
# checkout. nativestrict fails instead of copying when links are unavailable.
case "$(uname -s)" in
  MINGW*|MSYS*) export MSYS="${MSYS:+$MSYS }winsymlinks:nativestrict" ;;
  CYGWIN*) export CYGWIN="${CYGWIN:+$CYGWIN }winsymlinks:nativestrict" ;;
esac

echo ''

info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

user () {
  printf "\r  [ \033[0;33m??\033[0m ] $1\n"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit 1
}

# True when $1 opens with an [include] of $2. Tolerates CRLF, a BOM and spacing:
# the file may have been written on another host.
gitconfig_include_first () {
  local first second
  { IFS= read -r first; IFS= read -r second; } < "$1" || true
  first="${first%$'\r'}"; first="${first#$'\xef\xbb\xbf'}"
  second="${second%$'\r'}"

  # Git matches section and key names case-insensitively, values exactly.
  [[ "${first,,}" =~ ^[[:space:]]*\[include\][[:space:]]*$ ]] &&
  [[ "${second,,}" =~ ^[[:space:]]*path[[:space:]]*= ]] &&
  [[ "$second" =~ =[[:space:]]*"$2"[[:space:]]*$ ]]
}

gitconfig_includes () {
  git config --file "$1" --get-all include.path 2>/dev/null | grep -qxF "$2"
}

# `git config --global` writes follow a symlink into the checkout, so ~/.gitconfig
# stays a regular file; the include goes first so machine settings below it win.
setup_gitconfig_include () {
  local dst="$HOME/.gitconfig"
  local include='~/.gitconfig.dotfiles'
  local legacy='~/.dotfiles/git/gitconfig.symlink'
  local baseline="${include/#\~/$HOME}"

  # Git ignores an include it cannot open, so a skipped or failed link would
  # cost every baseline setting with no error.
  if [ ! -e "$baseline" ]
  then
    fail "$include is missing. Re-run and let bootstrap link it, then re-run."
  fi

  if [ -L "$dst" ]
  then
    # After a pull the old baseline is gone, so the link dangles.
    local target
    target="$(readlink -m "$dst")"
    case "$target" in
      "$DOTFILES_ROOT"/git/*) ;;
      *) fail "~/.gitconfig links to $target, not a config in $DOTFILES_ROOT/git. Remove it or migrate its settings, then re-run." ;;
    esac
    rm "$dst"
    success 'removed the ~/.gitconfig symlink into the checkout'
  fi

  if [ -f "$dst" ]
  then
    # Refuse a file git cannot parse rather than editing it.
    if ! git config --file "$dst" --list > /dev/null 2>&1
    then
      fail "git cannot parse ~/.gitconfig. Fix it, then re-run."
    fi

    if gitconfig_include_first "$dst" "$include"
    then
      success '~/.gitconfig already includes the baseline'
      return
    fi

    if gitconfig_includes "$dst" "$include"
    then
      fail "~/.gitconfig includes $include below the top, where the baseline overrides machine settings. Move it to the first line and re-run."
    fi

    if gitconfig_includes "$dst" "$legacy"
    then
      fail "~/.gitconfig includes $legacy, replaced by $include. Drop that include and re-run."
    fi
  fi

  local tmp="$dst.dotfiles.$$"
  {
    printf '[include]\n\tpath = %s\n' "$include"
    if [ -f "$dst" ]; then cat "$dst"; fi
  } > "$tmp"
  # Copy over the original rather than mv, which would drop its mode and owner.
  cat "$tmp" > "$dst"
  rm -f "$tmp"
  success 'added the baseline include to ~/.gitconfig'
}

get_backup_path () {
  local path=$1
  local candidate="${path}.backup"
  local stamp sequence=0

  if [ ! -e "$candidate" ] && [ ! -L "$candidate" ]; then
    printf '%s\n' "$candidate"
    return
  fi

  stamp=$(date +%Y%m%d%H%M%S)
  while :; do
    candidate="${path}.backup-${stamp}"
    if [ "$sequence" -gt 0 ]; then
      candidate="${candidate}-${sequence}"
    fi
    if [ ! -e "$candidate" ] && [ ! -L "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
    sequence=$((sequence + 1))
  done
}

link_file () {
  local src=$1 dst=$2

  local action=${all_action:-}
  local backup_path

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then
    if [ -L "$dst" ] && [ "$dst" -ef "$src" ]
    then
      success "already linked $src"
      return
    fi

    if [ -z "$action" ]
    then
      user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
      if ! read -r -n 1 action; then
        action=s
      fi
      printf '\n'

      case "$action" in
        o) action=overwrite ;;
        O) action=overwrite; all_action=$action ;;
        b) action=backup ;;
        B) action=backup; all_action=$action ;;
        S) action=skip; all_action=$action ;;
        *) action=skip ;;
      esac
    fi

    case "$action" in
      overwrite)
        rm -rf "$dst"
        success "removed $dst"
        ;;
      backup)
        backup_path=$(get_backup_path "$dst")
        mv "$dst" "$backup_path"
        success "moved $dst to $backup_path"
        ;;
      skip)
        success "skipped $src"
        return
        ;;
    esac
  fi

  ln -s "$src" "$dst"
  success "linked $src to $dst"
}

install_dotfiles () {
  info 'installing dotfiles'

  local all_action=

  for src in $(find -H "$DOTFILES_ROOT" -mindepth 1 -name '.*' -type d -prune -o -name '*.symlink' -print)
  do
    relative_src=$(echo $src | sed -e "s=$DOTFILES_ROOT==" -e "s=.symlink==")
    dst="$HOME/.$(echo $relative_src | cut -d "/" -f3-)"

    # create directory if needed
    dir=$(dirname $dst)
    if ! [ -d $dir ]
    then
      mkdir -p $dir
    fi
    #dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done

  # Topic bootstraps own setup that cannot use the *.symlink convention.
  # Source them so they share link_file and this run's collision choice.
  local topic_bootstrap
  for topic_bootstrap in "$DOTFILES_ROOT"/*/bootstrap.sh
  do
    [ -f "$topic_bootstrap" ] || continue
    . "$topic_bootstrap"
  done
}

install_dotfiles

# Add ~/.dotfiles link if not yet
if ! [[ -a "$HOME/.dotfiles" ]]
then
  echo ''
  echo "  Creating symbolic link ~/.dotfiles to $DOTFILES_ROOT"
  ln -s "$DOTFILES_ROOT" "$HOME/.dotfiles"
fi

# Verify ~/.dotfiles is now the expected symlink. If the user cloned directly
# into ~/.dotfiles (against README guidance), the directory exists but is not
# a symlink, and script/install's guard will (correctly) refuse to run.
# Fail here with a clearer message than install's guard would give.
if [ ! -L "$HOME/.dotfiles" ]; then
  fail "~/.dotfiles exists but is not a symlink (cloned directly into ~/.dotfiles?). Move the clone to another path (e.g. ~/code/dotfiles) and rerun script/bootstrap."
fi

# Runs under the guard above, so a bad ~/.dotfiles fails before ~/.gitconfig is
# touched, and after install_dotfiles has created the ~/.gitconfig.dotfiles link.
setup_gitconfig_include

# Apply optional local configuration before running installers.
DOTFILES_LOCAL="${DOTFILES_LOCAL:-$HOME/.dotfiles.local}"
local_configurator="$DOTFILES_LOCAL/script/configure"
if [ -f "$local_configurator" ]; then
  info 'running local configuration'
  DOTFILES_LOCAL="$DOTFILES_LOCAL" bash "$local_configurator"
fi

# Run topical install scripts.
info 'running script/install'
DOTFILES="$DOTFILES_ROOT" DOTFILES_LOCAL="$DOTFILES_LOCAL" "$DOTFILES_ROOT/script/install"

echo ''
echo '  All installed!'