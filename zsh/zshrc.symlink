# shortcut to this dotfiles path is $ZSH
export DOTFILES=$HOME/.dotfiles

# your project folder that we can `c [tab]` to
export PROJECTS=~/projects

# Keep PATH entries unique so re-sourcing this file (e.g. reload!) doesn't stack
# duplicate entries every time.
typeset -U path PATH

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files_
config_files_=($DOTFILES/*/*.zsh)
omz_file_=$DOTFILES/oh-my-zsh/omz.zsh

# load the path files
for file in ${(M)config_files_:#*/path.zsh}
do
  source $file
done

# load everything but the path files, oh-my-zsh and the completion files
for file in ${${config_files_:#*/(path|completion).zsh}:#$omz_file_}
do
  source $file
done

# oh-my-zsh runs compinit, so it has to precede the completion files calling compdef
source $omz_file_

# load every completion after compinit
for file in ${(M)config_files_:#*/completion.zsh}
do
  source $file
done

unset config_files_ omz_file_
