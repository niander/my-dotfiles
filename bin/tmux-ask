#!/usr/bin/env bash
#
# Ask a plain-English question about the live tmux setup and get an answer back.
#
# Reads the question on stdin rather than taking it as an argument, so the text
# never crosses tmux's command parser — quotes and apostrophes need no escaping.
#
# Prints shortcuts and prefix-prompt commands. Never runs them.
#
# USAGE:
#
#   $ tmux-ask            # asks about the active pane
#   $ tmux-ask %3         # asks about pane %3
#   $ echo "how do I move this window?" | tmux-ask

set -uo pipefail

MODEL="${TMUX_ASK_MODEL:-haiku}"
ADVISOR_MODEL="${TMUX_ASK_ADVISOR_MODEL:-sonnet}"
TIMEOUT="${TMUX_ASK_TIMEOUT:-45}"
STATE_TIMEOUT="${TMUX_ASK_STATE_TIMEOUT:-10}"

# Empty non-repo cwd: no CLAUDE.md or project settings for the backend to find.
SCRATCH="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-ask"

esc=$'\033'
dim="${esc}[2m"
bold="${esc}[1m"
red="${esc}[31m"
cyan="${esc}[36m"
reset="${esc}[0m"

die() {
  printf '%s%s%s\n' "$red" "$1" "$reset" >&2
  shift
  [ $# -gt 0 ] && printf '%s\n' "$@" >&2
  hold
  exit 1
}

# Popups close the instant the command exits, so pause on anything worth reading.
hold() {
  [ -t 0 ] || return 0
  printf '\n%s[any key to dismiss]%s' "$dim" "$reset"
  read -rsn1 _ 2>/dev/null || true
  printf '\n'
}

new_log() {
  mktemp "${SCRATCH}/error.XXXXXX" 2>/dev/null ||
    mktemp "${TMPDIR:-/tmp}/tmux-ask-error.XXXXXX"
}

# Everything the model needs to answer with real names instead of placeholders.
gather_state() {
  local pane="$1"

  printf 'tmux %s, prefix %s, base-index %s, pane-base-index %s\n' \
    "$(timeout -k 2s "$STATE_TIMEOUT" tmux -V | awk '{print $2}')" \
    "$(timeout -k 2s "$STATE_TIMEOUT" tmux show-options -gv prefix)" \
    "$(timeout -k 2s "$STATE_TIMEOUT" tmux show-options -gv base-index)" \
    "$(timeout -k 2s "$STATE_TIMEOUT" tmux show-window-options -gv pane-base-index)"

  printf '\nCURRENT (where the question came from):\n'
  timeout -k 2s "$STATE_TIMEOUT" tmux display-message -p -t "$pane" -F \
    '  session=#{session_name} window=#{window_index}:#{window_name} pane=#{pane_index} (#{pane_id}) cmd=#{pane_current_command} path=#{pane_current_path}'

  printf '\nSESSIONS:\n'
  timeout -k 2s "$STATE_TIMEOUT" tmux list-sessions -F '  #{session_name} — #{session_windows} window(s), #{?session_attached,attached,detached}'

  printf '\nWINDOWS (all sessions):\n'
  timeout -k 2s "$STATE_TIMEOUT" tmux list-windows -a -F \
    '  #{session_name}:#{window_index} #{window_name} — #{window_panes} pane(s)#{?window_active, [active in its session],}'

  printf '\nPANES (current window):\n'
  timeout -k 2s "$STATE_TIMEOUT" tmux list-panes -t "$pane" -F \
    '  #{pane_index} (#{pane_id}) #{pane_current_command} #{pane_width}x#{pane_height}#{?pane_active, [active],}'

  # Behavioural options only; styles and formats are long and never the answer.
  local noise='style|-format|^terminal-|^@resurrect-|^@sidebar-key-|^status-(left|right)|^message-|^mode-|^copy-mode|^clock-mode|^display-panes-(active-)?colour|^window-status'
  printf '\nOPTIONS (session):\n'
  timeout -k 2s "$STATE_TIMEOUT" tmux show-options -g | grep -vE "$noise" | sed 's/^/  /'
  printf '\nOPTIONS (window):\n'
  timeout -k 2s "$STATE_TIMEOUT" tmux show-window-options -g | grep -vE "$noise" | sed 's/^/  /'

  # This includes bindings supplied by plugins as well as tmux defaults.
  printf '\nLIVE KEYBINDINGS (all key tables):\n'
  timeout -k 2s "$STATE_TIMEOUT" tmux list-keys | sed 's/^/  /'
}

# Short by design: extra rules cost latency without sharpening the answers.
SYSTEM_PROMPT='Answer tmux questions from the STATE block describing the user'"'"'s live session.
Use LIVE KEYBINDINGS as the authoritative source for shortcuts; never invent one.
Treat CURRENT as the operation context. When the question says "this" or "current" pane, window, or session, use its ID or name from CURRENT explicitly; never infer it from a destination or from whichever target a previous command made active.
For multi-command operations, trace the state after each command and make every source and destination explicit. A newly created session has its own starter window and pane: preserve the requested object before cleaning up only the temporary object you created.
When a relevant shortcut exists, line 1 must be "Keys: ..." with the exact sequence. Use the STATE prefix value for prefix-table bindings; root-table bindings need no prefix. Choose the clearest matching shortcut and mention alternatives only when materially useful.
When a tmux command would help, line 2 must be "Command: ..." containing only the command accepted after pressing prefix then colon: omit the "tmux " executable prefix. Use real names from STATE, never placeholders, and quote names containing spaces.
If no relevant shortcut exists, say so on line 1 and provide the Command line when possible.
Then at most one short explanation line. Four lines max.
Plain terminal text only: no markdown, no backticks, no bullets, no preamble.
STATE lists current option values; if asked whether something is set, read it from STATE.
You cannot run commands and have not run any.
If the question is not about tmux, say so in one line.'

main() {
  [ -n "${TMUX:-}" ] || die "tmux-ask: not inside tmux."
  command -v tmux >/dev/null 2>&1 || die "tmux-ask: tmux not found on PATH."

  # Popups expand no formats and leave TMUX_PANE unset, so fall back to whatever
  # pane the client has active. An explicit id is honoured for use outside one.
  local pane=""
  if [ $# -gt 0 ] && [ -n "$1" ]; then
    pane="$(tmux display-message -p -t "$1" -F '#{pane_id}' 2>/dev/null)"
  fi
  case "$pane" in
    %[0-9]*) ;;
    *) pane="$(tmux display-message -p -F '#{pane_id}' 2>/dev/null)" ;;
  esac
  case "$pane" in
    %[0-9]*) ;;
    *) die "tmux-ask: could not determine the current pane." ;;
  esac

  local question
  if [ -t 0 ]; then
    printf '%sAsk about your tmux setup%s %s(enter to send, ctrl-c to cancel)%s\n' \
      "$bold" "$reset" "$dim" "$reset"
    printf '%s> %s' "$cyan" "$reset"
    IFS= read -r question || { printf '\n'; exit 0; }
  else
    IFS= read -r question || true
  fi

  # Empty input is a no-op, not a round-trip.
  case "$question" in
    *[![:space:]]*) ;;
    *) printf '%sNo question asked.%s\n' "$dim" "$reset"; hold; exit 0 ;;
  esac

  command -v claude >/dev/null 2>&1 ||
    die "tmux-ask: backend 'claude' not found on PATH." \
        "Install it, or point tmux-ask at another CLI agent."

  mkdir -p "$SCRATCH" 2>/dev/null || SCRATCH="${TMPDIR:-/tmp}/tmux-ask"
  mkdir -p "$SCRATCH" 2>/dev/null || die "tmux-ask: could not create a diagnostics directory."

  printf '%sreading tmux…%s\r' "$dim" "$reset"

  local state state_log
  state_log="$(new_log)" || die "tmux-ask: could not create a diagnostics log."
  state="$(gather_state "$pane" 2>"$state_log")" ||
    die "tmux-ask: could not read tmux state within ${STATE_TIMEOUT}s." "Diagnostics: $state_log"
  rm -f "$state_log"

  printf '\033[2K%sasking Claude…%s\r' "$dim" "$reset"

  # Single round-trip: state is pre-gathered and no tools are offered, so there
  # is no agentic loop. --system-prompt replaces the agent prompt, not appends.
  local out rc errfile
  errfile="$(new_log)" || die "tmux-ask: could not create a diagnostics log."
  out="$(
    cd "$SCRATCH" 2>/dev/null
    printf 'STATE:\n%s\n\nQUESTION: %s\n' "$state" "$question" |
      CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
      ENABLE_CLAUDEAI_MCP_SERVERS=false \
        timeout -k 5s "$TIMEOUT" claude -p \
          --model "$MODEL" \
          --advisor "$ADVISOR_MODEL" \
          --system-prompt "$SYSTEM_PROMPT" \
          --setting-sources project \
          --strict-mcp-config \
          --tools "" \
          --no-session-persistence \
          2>"$errfile"
  )"
  rc=$?
  printf '\033[2K'

  # This exits 0, so it has to be matched on rather than caught as a failure.
  case "$out" in
    *"Not logged in"*|*"auth login"*|*"/login"*)
      die "tmux-ask: not logged in." \
          "Run once:" \
          "  claude auth login" \
          "Diagnostics: $errfile"
      ;;
  esac

  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    die "tmux-ask: backend timed out after ${TIMEOUT}s." "Diagnostics: $errfile"
  fi

  if [ "$rc" -ne 0 ] || [ -z "${out//[[:space:]]/}" ]; then
    local detail
    detail="$(head -c 400 "$errfile" 2>/dev/null | head -n 4)"
    die "tmux-ask: backend failed (exit $rc)." "${detail:-No output.}" "Diagnostics: $errfile"
  fi
  rm -f "$errfile"

  printf '%s\n' "$out"

  # Copy a prefix-prompt command only, without a trailing newline.
  if [ -t 0 ]; then
    local command
    command="$(printf '%s\n' "$out" | sed -n 's/^Command: //p' | head -n 1)"
    case "$command" in
      *[![:space:]]*) ;;
      *) command="" ;;
    esac

    if [ -n "$command" ]; then
      printf '\n%s[y] copy command   [any key] dismiss%s' "$dim" "$reset"
    else
      printf '\n%s[any key] dismiss%s' "$dim" "$reset"
    fi
    local key
    read -rsn1 key 2>/dev/null || true
    printf '\n'
    if [ "$key" = "y" ] && [ -n "$command" ]; then
      # -w forwards the buffer to the terminal's clipboard over OSC52.
      printf '%s' "$command" |
        tmux load-buffer -w - 2>/dev/null &&
        printf '%scopied to clipboard%s\n' "$dim" "$reset"
      sleep 0.6
    fi
  fi
}

main "$@"
