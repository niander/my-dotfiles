#!/bin/sh
#
# Run a command with $EDITOR forced to block until the edit is finished.
#
# Terminal editors already block. GUI ones fork unless asked not to, and they
# reject the flag when they don't need it, so only add it for those.
#
case "${EDITOR##*/}" in
    code|code-insiders|codium|zed|windsurf|subl) EDITOR="$EDITOR --wait" ;;
esac

export EDITOR
exec "$@"
